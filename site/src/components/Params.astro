---
import { projectOf, readData, type SimData } from '../lib/site';
const { sim, project } = Astro.props as { sim: string; project?: string };
const data = readData<SimData>(projectOf(Astro, project), 'sim', `${sim}.json`);
const label = (k: string) => k.replace(/_per_/g, '/').replace(/_/g, ' ');
---
<div class="table-wrap">
  <table>
    <thead><tr><th>Input</th><th class="num">Value</th></tr></thead>
    <tbody>
      {Object.entries(data.params).map(([k, v]) => <tr><td>{label(k)}</td><td class="num">{String(v)}</td></tr>)}
    </tbody>
  </table>
</div>
